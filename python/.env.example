# Copy to python/.env and fill in.

# Auth bridge to the Node server (must match server/.env)
JWT_SECRET=
INTERNAL_SECRET=
NODE_INTERNAL_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:5173

# LLM backend switch: false = cloud (Groq, then Gemini), true = local Ollama
USE_LOCAL_LLM=false

# Cloud (used only when USE_LOCAL_LLM=false)
CLOUD_LLM_ORDER=groq,gemini
GROQ_API_KEY=
# Optional extra keys from other free-tier accounts; used when the first hits its rate limit
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-120b
# Answer budget per request; the free tier counts it against 8K tokens/minute
# GROQ_MAX_COMPLETION_TOKENS=1000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local (used only when USE_LOCAL_LLM=true; needs Ollama installed and running)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Speech-to-text (local faster-whisper)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Admin scraping (optional): LLM time budget for /listings/extract (Node waits 60 s)
# and the polite delay between pages of a /kb/ingest-url site crawl
# LISTING_LLM_TIMEOUT=40
# LISTING_TOTAL_BUDGET=50
# KB_CRAWL_DELAY=0.5
