# Copy to server/.env and fill in. The server refuses to start without the
# first three values.
MONGODB_URI=
JWT_SECRET=
# Shared with python/.env — authenticates Node <-> Python calls
INTERNAL_SECRET=

# University email (OTPs + notifications): set it in the web admin panel,
# Admin → Settings. These two are only a first-boot fallback (Gmail address +
# App Password) used while nothing is saved there.
# EMAIL_USER=
# EMAIL_PASS=
# Key for encrypting the email app password saved from Admin → Settings
# (defaults to JWT_SECRET; changing it means re-entering the app password).
# SETTINGS_SECRET=

PORT=3000
PYTHON_BACKEND_URL=http://localhost:8000
# Allowed browser origin(s) for CORS, comma-separated
CLIENT_URL=http://localhost:5173
# Web app address used for links in emails (defaults to the first CLIENT_URL)
# APP_URL=https://uniassist.example.edu
# Set to 1 when running behind a reverse proxy so rate limits see real client IPs
# TRUST_PROXY=1

# Hours a Pending complaint may wait for its first staff response before it is
# escalated to the department head + admins (per-department override in the
# admin Departments page). Default 48.
# ISSUE_SLA_HOURS=48
# Set to true to turn off background jobs (the SLA check) on this instance
# DISABLE_SCHEDULERS=true
