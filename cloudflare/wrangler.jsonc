// UniAssist backend: Worker + API server container + AI service container.
// Deploy from this folder with `npm run deploy` (Docker must be running) or
// via .github/workflows/deploy-cloudflare.yml. Full guide: doc/ (PDF).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uniassist-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "containers": [
    {
      // server/ — Express + Mongoose. 1 GiB RAM.
      "class_name": "ApiServer",
      "image": "../server/Dockerfile",
      "image_build_context": "../server",
      "instance_type": "basic",
      // One instance: rate limits, guest sessions and jobs live in memory.
      "max_instances": 1
    },
    {
      // python/ — FastAPI, ChromaDB, sentence-transformers, faster-whisper.
      // 4 GiB RAM / 8 GB disk for torch + the models baked into the image.
      "class_name": "AiService",
      "image": "../python/Dockerfile",
      "image_build_context": "../python",
      "instance_type": "standard-1",
      // One instance: ChromaDB is a single on-disk store (snapshotted to R2).
      "max_instances": 1
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "API_SERVER", "class_name": "ApiServer" },
      { "name": "AI_SERVICE", "class_name": "AiService" }
    ]
  },
  "exports": {
    "ApiServer": { "type": "durable-object", "storage": "sqlite" },
    "AiService": { "type": "durable-object", "storage": "sqlite" }
  },

  // Uploads (issue attachments, avatars, event posters) and the ChromaDB
  // snapshot (kb/chroma_db.tar.gz). Create it first: npx wrangler r2 bucket create uniassist-uploads
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "uniassist-uploads" }],

  // SLA escalation check (was a 30-minute in-process timer). Hourly, not
  // every 30 minutes: each run wakes the API server, which then stays up for
  // its sleepAfter (src/index.js) — a 30-minute cron would keep it running
  // (and billed) around the clock.
  "triggers": { "crons": ["0 * * * *"] },

  // Non-secret settings. Secrets (MONGODB_URI, JWT_SECRET, INTERNAL_SECRET,
  // R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, GROQ_API_KEY, GEMINI_API_KEY, ...)
  // are set with `npx wrangler secret put <NAME>` — never here.
  "vars": {
    // This Worker's own public URL, e.g. https://uniassist-api.<you>.workers.dev
    // or https://api.your-domain.com (no trailing slash).
    "PUBLIC_URL": "https://uniassist-api.REPLACE-ME.workers.dev",
    // The web app's URL(s), comma-separated (CORS + email links).
    "CLIENT_URL": "https://uniassist-web.REPLACE-ME.workers.dev",
    // Cloudflare account id (R2 endpoint) and the bucket above.
    "R2_ACCOUNT_ID": "REPLACE-ME",
    "R2_BUCKET": "uniassist-uploads",
    "CLOUD_LLM_ORDER": "groq,gemini",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GEMINI_MODEL": "gemini-2.5-flash",
    // Must match the model baked into python/Dockerfile (ARG WHISPER_MODEL).
    "WHISPER_MODEL": "base"
  }
}
